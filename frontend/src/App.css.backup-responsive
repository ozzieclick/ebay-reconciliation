  margin: 0 auto 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.navigation {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto 28px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 6px;
  padding: 6px;
}

.dashboard-section,
.view-payouts,
.sync-section,
.accounts-section {
  width: 100%;
  max-width: 1400px;

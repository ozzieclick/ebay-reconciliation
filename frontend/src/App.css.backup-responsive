  border-radius: 9px;
  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease;
}

.filter-group input:hover,
.filter-group select:hover {
  border-color: #98a2b3;
}

.filter-button {
  height: 44px;
  border-radius: 9px;
  padding: 0 22px;
  background: #5b5bd6;
  box-shadow: 0 2px 5px rgb(91 91 214 / 18%);
  transition:
    background 0.18s ease,
    box-shadow 0.18s ease,
    transform 0.18s ease;
}

.filter-button:hover {
  background: #4f4fc5;
  box-shadow: 0 4px 9px rgb(91 91 214 / 22%);
}

.filter-button:active {
  transform: translateY(1px);
}

.summary {

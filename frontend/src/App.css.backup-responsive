}

.summary-card span {
  font-size: 11px;
  font-weight: 650;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.summary-card strong {
  margin-top: 7px;
  color: #101828;
  font-size: 32px;
  letter-spacing: -0.8px;
}

.table-card {
  border-radius: 14px;
  box-shadow:
    0 1px 2px rgb(16 24 40 / 4%),
    0 5px 16px rgb(16 24 40 / 4%);
}

.table-card table {
  min-width: 950px;
}

.table-card th {
  height: 48px;
  padding: 0 18px;
  background: #f8f9fc;
  border-bottom: 1px solid #e4e7ec;
  color: #667085;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.055em;
}

.table-card td {
  height: 62px;
  padding: 0 18px;
  color: #344054;
  font-size: 13px;
  border-bottom: 1px solid #f0f1f3;
}

.table-card tbody tr {
  transition: background 0.15s ease;
}

.table-card tbody tr:hover {
  background: #fafaff;
}

.table-card tbody tr:last-child td {
  border-bottom: 0;
}

.table-card td:nth-child(1) {
  color: #475467;
  font-size: 13px;
}

.table-card td:nth-child(2) {
  color: #667085;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 12px;
}

.table-card td:nth-child(3) {
  color: #101828;
  font-size: 14px;
  font-weight: 700;
}

.table-card td:nth-child(5) {
  color: #475467;
  font-weight: 600;
}

.table-card td:nth-child(6) {
  color: #667085;
  font-size: 12px;
}

.table-card .status {
  padding: 5px 10px;
  font-size: 11px;
  font-weight: 650;
}

.table-card .empty {
  height: 180px;
  padding: 40px 16px;
  color: #667085;
  font-size: 14px;
}

/* Estados de payout */

.table-card .status-succeeded {
  border: 1px solid #abefc6;
  background: #ecfdf3;
  color: #027a48;
}

.table-card .status-initiated {
  border: 1px solid #b2ddff;
  background: #eff8ff;
  color: #175cd3;
}

.table-card .status-retryable_failed {
  border: 1px solid #fedf89;
  background: #fffaeb;
  color: #b54708;
}

.table-card .status-terminal_failed {
  border: 1px solid #fecdca;
  background: #fef3f2;
  color: #b42318;
}

@media (max-width: 700px) {
  .filters {
    padding: 18px;
  }

  .summary-card {
    width: 100%;
  }

  .table-card {
    border-radius: 12px;
  }

  .table-card th,
  .table-card td {
    padding-left: 14px;
    padding-right: 14px;
  }
}

/* Rediseño de Cuentas */

.accounts-section {
  max-width: 1400px;
  margin: 0 auto;
}

.accounts-header {
  margin-bottom: 24px;
}

.accounts-header h2 {
  font-size: 22px;
  letter-spacing: -0.4px;
}

.accounts-header p {
  margin-top: 6px;
  font-size: 14px;
}

.add-account-button {
  height: 44px;
  padding: 0 18px;
  border-radius: 9px;
  font-size: 13px;
  box-shadow: 0 2px 6px rgb(91 91 214 / 18%);
}

.new-account-card {
  margin-bottom: 22px;
  padding: 22px 24px;
  border-radius: 14px;
  box-shadow:
    0 1px 2px rgb(16 24 40 / 4%),
    0 4px 12px rgb(16 24 40 / 3%);
}

.new-account-card label {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.045em;
}

.new-account-card .account-name-input {
  height: 44px;
}

.accounts-grid {
  grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  gap: 20px;
}

.account-card {
  min-height: 245px;
  padding: 24px;
  border-radius: 16px;
  box-shadow:
    0 1px 2px rgb(16 24 40 / 4%),
    0 4px 14px rgb(16 24 40 / 3%);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.account-card:hover {
  transform: translateY(-1px);
  box-shadow:
    0 2px 4px rgb(16 24 40 / 5%),
    0 8px 20px rgb(16 24 40 / 6%);
}

.account-label {
  margin-bottom: 7px;
  font-size: 11px;
  letter-spacing: 0.06em;
}

.account-card h2 {
  font-size: 19px;
  line-height: 1.35;
}

.account-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 10px;
  border: 1px solid #abefc6;
  background: #ecfdf3;
  color: #027a48;
  font-size: 11px;
  font-weight: 650;
}

.account-status::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
}

.account-details {
  display: grid;
  grid-template-columns: 1fr;
  gap: 15px;
  margin-top: 24px;
  padding: 18px 0;
  border-top: 1px solid #eaecf0;
  border-bottom: 1px solid #eaecf0;
}

.account-details span {
  margin-bottom: 5px;
  font-size: 11px;
  font-weight: 650;
  text-transform: uppercase;
  letter-spacing: 0.045em;
}

.account-details strong {
  color: #344054;
  font-size: 14px;
  font-weight: 550;
}

.account-card-actions {
  padding-top: 20px;
}

.connect-button,
.connected-button,
.account-card-actions .edit-button {
  height: 40px;
  border-radius: 9px;
  font-size: 12px;
}

.connect-button {
  padding: 0 16px;
  box-shadow: 0 2px 5px rgb(91 91 214 / 16%);
}

.connected-button {
  padding: 0 15px;
}

.account-card-actions .edit-button {
  padding: 0 15px;
}

/* Edición de cuenta */

.account-card > .account-name-input {
  height: 44px;
  margin-top: 10px;
}

.account-card > label {
  color: #475467;
  font-size: 12px;
  font-weight: 650;
  text-transform: uppercase;
  letter-spacing: 0.045em;
}

.account-actions {
  padding-top: 20px;
}

.save-button,
.cancel-button {
  height: 40px;
  border-radius: 9px;
}

.save-button {
  background: #5b5bd6;
}

.save-button:hover {
  background: #4f4fc5;
}

/* Responsive cuentas */

@media (max-width: 700px) {
  .accounts-header {
    margin-bottom: 18px;
  }

  .accounts-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .account-card {
    min-height: 230px;
    padding: 20px;
    border-radius: 14px;
  }

  .account-card-header {
    gap: 12px;
  }

  .account-card h2 {
    font-size: 18px;
  }

  .new-account-card {
    padding: 18px;
    border-radius: 12px;
  }
}

/* Dashboard principal */

.dashboard-section {
  max-width: 1400px;
  margin: 0 auto;
}

.dashboard-section .section-header {
  margin-bottom: 22px;
}

.dashboard-section .section-header h2 {
  margin: 0;
  color: #101828;
  font-size: 22px;
  line-height: 1.3;
  letter-spacing: -0.3px;
}

.dashboard-section .section-header p {
  margin: 6px 0 0;
  color: #667085;
  font-size: 14px;
}

.dashboard-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 20px;
}

.dashboard-stat-card {
  min-height: 145px;
  padding: 22px 24px;
  border: 1px solid #e4e7ec;
  border-radius: 16px;
  background: #ffffff;
  box-shadow:
    0 1px 2px rgb(16 24 40 / 4%),
    0 4px 12px rgb(16 24 40 / 3%);
}

.dashboard-stat-card span {
  display: block;
  color: #667085;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.dashboard-stat-card strong {
  display: block;
  margin-top: 12px;
  color: #101828;
  font-size: 36px;
  line-height: 1;
  letter-spacing: -1px;
}

.dashboard-stat-card small {
  display: block;
  margin-top: 10px;
  color: #98a2b3;
  font-size: 12px;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
  gap: 20px;
}

.dashboard-panel {
  overflow: hidden;
  border: 1px solid #e4e7ec;
  border-radius: 16px;
  background: #ffffff;
  box-shadow:
    0 1px 2px rgb(16 24 40 / 4%),
    0 4px 14px rgb(16 24 40 / 3%);
}

.dashboard-panel-header {
  padding: 22px 24px;
  border-bottom: 1px solid #eaecf0;
}

.dashboard-panel-header h3 {
  margin: 0;
  color: #101828;
  font-size: 17px;
  line-height: 1.35;
}

.dashboard-panel-header p {
  margin: 5px 0 0;
  color: #667085;
  font-size: 13px;
}

.dashboard-account-list {
  padding: 0 24px;
}

.dashboard-account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 76px;
  border-bottom: 1px solid #f0f1f3;
}

.dashboard-account-row:last-child {
  border-bottom: 0;
}

.dashboard-account-row > div {
  min-width: 0;
}

.dashboard-account-row strong {
  display: block;
  color: #344054;
  font-size: 14px;
  font-weight: 650;
}

.dashboard-account-row span:not(.status) {
  display: block;
  margin-top: 4px;
  color: #98a2b3;
  font-size: 12px;
}

.dashboard-account-row .status {
  flex-shrink: 0;
  padding: 5px 10px;
  font-size: 11px;
  font-weight: 650;
}

.dashboard-account-row .status-success {
  border: 1px solid #abefc6;
  background: #ecfdf3;
  color: #027a48;
}

.dashboard-account-row .status-syncing {
  border: 1px solid #b2ddff;
  background: #eff8ff;
  color: #175cd3;
}

.dashboard-account-row .status-failed {
  border: 1px solid #fecdca;
  background: #fef3f2;
  color: #b42318;
}

.dashboard-account-row .status-never_synced,
.dashboard-account-row .status-unknown {
  border: 1px solid #eaecf0;
  background: #f9fafb;
  color: #667085;
}

.dashboard-empty {
  margin: 0;
  padding: 30px 0;
  color: #667085;
  font-size: 13px;
}

.dashboard-actions {
  display: flex;
  flex-direction: column;
  padding: 8px 12px;
}

.dashboard-actions button {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  width: 100%;
  padding: 16px 12px;
  border: 0;
  border-bottom: 1px solid #f0f1f3;
  border-radius: 8px;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
  transition: background 0.15s ease;
}

.dashboard-actions button:last-child {
  border-bottom: 0;
}

.dashboard-actions button:hover {
  background: #f8f9fc;
}

.dashboard-actions strong {
  color: #344054;
  font-size: 14px;
  font-weight: 650;
}

.dashboard-actions span {
  color: #98a2b3;
  font-size: 12px;
}

@media (max-width: 900px) {
  .dashboard-stats {
    grid-template-columns: 1fr;
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  .dashboard-section .section-header h2 {
    font-size: 20px;
  }

  .dashboard-stat-card {
    min-height: 125px;
    padding: 20px;
    border-radius: 14px;
  }

  .dashboard-stat-card strong {
    font-size: 32px;
  }

  .dashboard-panel {
    border-radius: 14px;
  }

  .dashboard-panel-header {
    padding: 19px 20px;
  }

  .dashboard-account-list {
    padding: 0 20px;
  }

  .dashboard-account-row {
    min-height: 70px;
  }
}


/* Corrección del layout principal */

.header {

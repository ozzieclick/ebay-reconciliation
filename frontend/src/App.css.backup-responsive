* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #f4f6fb;
  color: #101828;
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
}

button,
input,
select {
  font: inherit;
}

.app {
  min-height: 100vh;
  padding: 32px;
}

.header {
  max-width: 1400px;
  margin: 0 auto 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.header h1 {
  margin: 0;
  font-size: 30px;
  line-height: 1.2;
  letter-spacing: -0.6px;
}

.header p {
  margin: 7px 0 0;
  color: #667085;
  font-size: 15px;
}

.header button {
  border: 0;
  border-radius: 9px;
  padding: 11px 18px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}

.refresh-button {
  height: 42px;
  background: #101828;
  color: #fff;
  box-shadow: 0 1px 2px rgb(16 24 40 / 10%);
}

.refresh-button:hover {
  background: #1d2939;
}

.header button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

/* Navegación */

.navigation {
  max-width: 1400px;
  margin: 0 auto 30px;
  margin-left: max(calc((100% - 1400px) / 2), 0px);
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px;
  width: fit-content;
  border: 1px solid #dfe3ea;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 3px 10px rgb(16 24 40 / 6%);
}

.nav-button {
  min-width: 125px;
  height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  border: 0;
  border-radius: 9px;
  padding: 0 18px;
  background: transparent;
  color: #667085;
  font-size: 14px;
  font-weight: 650;
  cursor: pointer;
  transition:
    background 0.18s ease,
    color 0.18s ease,
    box-shadow 0.18s ease;
}

.nav-button:hover {
  background: #f2f4ff;
  color: #4754c7;
}

.nav-button.active {
  background: #5b5bd6;
  color: #ffffff;
  box-shadow: 0 3px 8px rgb(91 91 214 / 25%);
}

.nav-button.active:hover {
  background: #4f4fc5;
  color: #ffffff;
}

.nav-icon {
  width: 21px;
  height: 21px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 800;
}

.nav-button:not(.active) .nav-icon {
  background: #f2f4f7;
  color: #667085;
}

.nav-button.active .nav-icon {
  background: rgb(255 255 255 / 18%);
  color: #ffffff;
}

/* Filtros */

.filters {
  max-width: 1400px;
  margin: 0 auto 24px;
  padding: 22px 24px;
  border: 1px solid #e4e7ec;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 1px 2px rgb(16 24 40 / 5%);
}

.filters form {
  display: flex;
  align-items: flex-end;
  gap: 18px;
  flex-wrap: wrap;
}

.filter-group {
  display: flex;
  flex-direction: column;
  gap: 7px;
  min-width: 190px;
}

.filter-group label {
  color: #344054;
  font-size: 13px;
  font-weight: 600;
}

.filter-group input,
.filter-group select {
  height: 42px;
  padding: 0 12px;
  border: 1px solid #d0d5dd;
  border-radius: 8px;
  background: #fff;
  color: #344054;
}

.filter-group input:focus,
.filter-group select:focus,
.account-name-input:focus {
  outline: 3px solid rgb(84 104 255 / 12%);
  border-color: #98a2b3;
}

.filter-button {
  height: 42px;
  border: 0;
  border-radius: 8px;
  padding: 0 20px;
  background: #101828;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}

.filter-button:hover {
  background: #1d2939;
}

.filter-button:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* Resumen */

.summary {
  max-width: 1400px;
  margin: 0 auto 24px;
}

.summary-card {
  width: 230px;
  padding: 20px 22px;
  border: 1px solid #e4e7ec;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 1px 2px rgb(16 24 40 / 5%);
}

.summary-card span {
  display: block;
  color: #667085;
  font-size: 13px;
  font-weight: 500;
}

.summary-card strong {
  display: block;
  margin-top: 8px;
  font-size: 30px;
  line-height: 1;
}

/* Mensajes y tabla */

.message,
.error,
.table-card,
.accounts-section {
  max-width: 1400px;
  margin-left: auto;
  margin-right: auto;
}

.error {
  margin-bottom: 20px;
  padding: 14px 16px;
  border: 1px solid #fecdca;
  border-radius: 9px;
  background: #fef3f2;
  color: #b42318;
}

.table-card {
  overflow-x: auto;
  border: 1px solid #e4e7ec;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 1px 2px rgb(16 24 40 / 5%);
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 900px;
}

th,
td {
  padding: 15px 18px;
  text-align: left;
  border-bottom: 1px solid #eaecf0;
  white-space: nowrap;
}

th {
  background: #f9fafb;
  color: #475467;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

td {
  color: #344054;
  font-size: 14px;
}

tbody tr:last-child td {
  border-bottom: 0;
}

tbody tr:hover {
  background: #f9fafb;
}

/* Estados */

.status {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 4px 9px;
  font-size: 12px;
  font-weight: 600;
}

.status-succeeded {
  background: #ecfdf3;
  color: #027a48;
}

.status-initiated {
  background: #eff8ff;
  color: #175cd3;
}

.status-retryable_failed {
  background: #fffaeb;
  color: #b54708;
}

.status-terminal_failed {
  background: #fef3f2;
  color: #b42318;
}

.empty {
  padding: 48px 16px;
  text-align: center;
  color: #667085;
}

/* Cuentas */

.accounts-section {
  margin-top: 4px;
}

.accounts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 20px;
}

.account-card {
  min-height: 230px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  border: 1px solid #e4e7ec;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 2px 4px rgb(16 24 40 / 4%);
}

.account-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.account-label {
  display: block;
  margin-bottom: 8px;
  color: #667085;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.account-card h2 {
  margin: 0;
  color: #101828;
  font-size: 21px;
  line-height: 1.3;
  letter-spacing: -0.3px;
}

.account-status {
  flex-shrink: 0;
  padding: 5px 10px;
  border-radius: 999px;
  background: #ecfdf3;
  color: #027a48;
  font-size: 12px;
  font-weight: 600;
  text-transform: capitalize;
}

.account-details {
  margin-top: 28px;
  padding: 16px 0;
  border-top: 1px solid #eaecf0;
  border-bottom: 1px solid #eaecf0;
}

.account-details span {
  display: block;
  margin-bottom: 6px;
  color: #667085;
  font-size: 12px;
  font-weight: 500;
}

.account-details strong {
  color: #344054;
  font-size: 14px;
  font-weight: 500;
}

.edit-button {
  align-self: flex-start;
  margin-top: auto;
  padding: 10px 14px;
  border: 1px solid #d0d5dd;
  border-radius: 8px;
  background: #fff;
  color: #344054;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}

.edit-button:hover {
  background: #f9fafb;
  border-color: #98a2b3;
}

.account-name-input {
  width: 100%;
  height: 44px;
  margin-top: 12px;
  padding: 0 13px;
  border: 1px solid #d0d5dd;
  border-radius: 8px;
  color: #344054;
  background: #fff;
}

.account-actions {
  display: flex;
  gap: 10px;
  margin-top: auto;
  padding-top: 24px;
}

.save-button,
.cancel-button {
  height: 40px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}

.save-button {
  border: 0;
  background: #101828;
  color: #fff;
}

.save-button:hover {
  background: #1d2939;
}

.cancel-button {
  border: 1px solid #d0d5dd;
  background: #fff;
  color: #344054;
}

.cancel-button:hover {
  background: #f9fafb;
}

.save-button:disabled,
.cancel-button:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* Responsive */

@media (max-width: 700px) {
  .app {
    padding: 20px 14px;
  }

  .header {
    align-items: flex-start;
    margin-bottom: 20px;
  }

  .header h1 {
    font-size: 23px;
  }

  .header p {
    font-size: 14px;
  }

  .navigation {
    width: 100%;
    margin: 0 auto 20px;
  }

  .nav-button {
    flex: 1;
    min-width: 0;
  }

  .filters {
    padding: 18px;
  }

  .filters form {
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
  }

  .filter-group {
    min-width: 0;
    width: 100%;
  }

  .filter-group input,
  .filter-group select,
  .filter-button {
    width: 100%;
  }

  .summary-card {
    width: 100%;
  }

  .accounts-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .account-card {
    min-height: 220px;
    padding: 20px;
  }

  .account-card h2 {
    font-size: 19px;
  }

  .account-card-header {
    gap: 10px;
  }

  .account-status {
    font-size: 11px;
  }
}

/* Encabezado de cuentas */

.accounts-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.accounts-header h2 {
  margin: 0;
  color: #101828;
  font-size: 22px;
  line-height: 1.3;
  letter-spacing: -0.3px;
}

.accounts-header p {
  margin: 5px 0 0;
  color: #667085;
  font-size: 14px;
}

.add-account-button {
  height: 42px;
  flex-shrink: 0;
  border: 0;
  border-radius: 8px;
  padding: 0 17px;
  background: #5b5bd6;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 2px 5px rgb(91 91 214 / 20%);
  transition:
    background 0.18s ease,
    box-shadow 0.18s ease,
    transform 0.18s ease;
}

.add-account-button:hover {
  background: #4f4fc5;
  box-shadow: 0 3px 8px rgb(91 91 214 / 25%);
}

.add-account-button:active {
  transform: translateY(1px);
}

/* Formulario de nueva cuenta */

.new-account-card {
  margin-bottom: 20px;
  padding: 22px 24px;
  border: 1px solid #e4e7ec;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 1px 2px rgb(16 24 40 / 5%);
}

.new-account-card label {
  display: block;
  margin-bottom: 7px;
  color: #344054;
  font-size: 13px;
  font-weight: 600;
}

.new-account-card .account-name-input {
  margin-top: 0;
}

@media (max-width: 700px) {
  .accounts-header {
    align-items: stretch;
    flex-direction: column;
    gap: 14px;
  }

  .add-account-button {
    width: 100%;
  }

  .new-account-card {
    padding: 18px;
  }
}

.account-card-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: auto;
  padding-top: 24px;
}

.connect-button,
.connected-button {
  height: 40px;
  padding: 0 14px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}

.connect-button {
  border: 0;
  background: #5b5bd6;
  color: #fff;
}

.connect-button:hover {
  background: #4f4fc5;
}

.connected-button {
  border: 1px solid #a6f4c5;
  background: #ecfdf3;
  color: #027a48;
}

.connected-button:hover {
  background: #dffbea;
}

.account-card-actions .edit-button {
  margin-top: 0;
}

@media (max-width: 700px) {
  .account-card-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .connect-button,
  .connected-button,
  .account-card-actions .edit-button {
    width: 100%;
  }
}

/* Dashboard de sincronización */

.sync-section {
  max-width: 1400px;
  margin: 0 auto;
}

.sync-section .section-header {
  margin-bottom: 22px;
}

.sync-section .section-header h2 {
  margin: 0;
  color: #101828;
  font-size: 22px;
  line-height: 1.3;
  letter-spacing: -0.3px;
}

.sync-section .section-header p {
  margin: 6px 0 0;
  color: #667085;
  font-size: 14px;
}

.sync-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(430px, 1fr));
  gap: 20px;
}

.sync-card {
  position: relative;
  overflow: hidden;
  padding: 24px;
  border: 1px solid #e4e7ec;
  border-radius: 16px;
  background: #ffffff;
  box-shadow:
    0 1px 2px rgb(16 24 40 / 4%),
    0 4px 12px rgb(16 24 40 / 3%);
  transition:
    box-shadow 0.2s ease,
    transform 0.2s ease;
}

.sync-card:hover {
  transform: translateY(-1px);
  box-shadow:
    0 2px 4px rgb(16 24 40 / 5%),
    0 8px 20px rgb(16 24 40 / 6%);
}

.sync-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  padding-bottom: 20px;
  border-bottom: 1px solid #eaecf0;
}

.sync-card-header h3 {
  margin: 0;
  color: #101828;
  font-size: 18px;
  line-height: 1.35;
  letter-spacing: -0.2px;
}

.sync-card-header p {
  margin: 5px 0 0;
  color: #667085;
  font-size: 13px;
}

.sync-card-header .status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 11px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 650;
}

.sync-card-header .status::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
}

.sync-card-header .status-success {
  border-color: #abefc6;
  background: #ecfdf3;
  color: #027a48;
}

.sync-card-header .status-syncing {
  border-color: #b2ddff;
  background: #eff8ff;
  color: #175cd3;
}

.sync-card-header .status-failed {
  border-color: #fecdca;
  background: #fef3f2;
  color: #b42318;
}

.sync-card-header .status-never_synced,
.sync-card-header .status-unknown {
  border-color: #eaecf0;
  background: #f9fafb;
  color: #667085;
}

.sync-card-details {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  margin-top: 20px;
  overflow: hidden;
  border: 1px solid #eaecf0;
  border-radius: 11px;
  background: #eaecf0;
}

.sync-card-details > div {
  min-height: 78px;
  padding: 15px 16px;
  background: #ffffff;
}

.sync-card-details span {
  display: block;
  margin-bottom: 7px;
  color: #667085;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.045em;
}

.sync-card-details strong {
  display: block;
  color: #344054;
  font-size: 14px;
  font-weight: 650;
  line-height: 1.35;
}

.sync-error {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 16px;
  padding: 13px 15px;
  border: 1px solid #fecdca;
  border-radius: 10px;
  background: #fef3f2;
}

.sync-error span {
  color: #b42318;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.045em;
}

.sync-error strong {
  color: #912018;
  font-size: 13px;
  font-weight: 550;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

@media (max-width: 700px) {
  .sync-section .section-header h2 {
    font-size: 20px;
  }

  .sync-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .sync-card {
    padding: 18px;
    border-radius: 14px;
  }

  .sync-card-header {
    gap: 12px;
    padding-bottom: 17px;
  }

  .sync-card-header h3 {
    font-size: 17px;
  }

  .sync-card-header .status {
    padding: 5px 9px;
    font-size: 11px;
  }

  .sync-card-details {
    grid-template-columns: 1fr;
    margin-top: 16px;
  }

  .sync-card-details > div {
    min-height: auto;
    padding: 13px 14px;
  }

  .sync-error {
    margin-top: 14px;
  }
}


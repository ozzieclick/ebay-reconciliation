  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.header > div:first-child {
  min-width: 0;
}

.header h1 {
  margin: 0;
}

.header p {
  margin: 4px 0 0;
}

.navigation {
  display: flex;
  align-items: center;
  gap: 6px;
  width: 100%;
  margin: 0 0 28px;
  padding: 6px;
  border: 1px solid #e4e7ec;
  border-radius: 12px;
  background: #ffffff;
  box-shadow:
    0 1px 2px rgb(16 24 40 / 4%),
    0 3px 10px rgb(16 24 40 / 3%);
}

.navigation .nav-button {
  flex: 0 0 auto;
  min-height: 40px;
  padding: 0 16px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #667085;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition:
    background 0.15s ease,
    color 0.15s ease;
}

.navigation .nav-button:hover {
  background: #f8f9fc;
  color: #344054;
}

.navigation .nav-button.active {
  background: #f0f0ff;
  color: #4f46c5;
}

.navigation .nav-icon {
  margin-right: 6px;
}

@media (max-width: 700px) {
  .header {
    align-items: flex-start;
  }

  .navigation {
    overflow-x: auto;
    margin-bottom: 20px;
  }

  .navigation .nav-button {
    white-space: nowrap;
    padding: 0 13px;
  }
}


/* Color principal de navegación */

.navigation .nav-button.active {
  background: #5b5bd6;
  color: #ffffff;
}

.navigation .nav-button.active:hover {
  background: #4f4fc5;
  color: #ffffff;
}


/* Dashboard - tarjetas principales */

.dashboard-stats {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.dashboard-stat-card {
  position: relative;
  min-height: 155px;
  padding: 24px 26px;
  border: 1px solid #e4e7ec;
  border-radius: 16px;
  background: #ffffff;
  box-shadow:
    0 1px 2px rgb(16 24 40 / 4%),
    0 6px 18px rgb(16 24 40 / 4%);
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease;
}

.dashboard-stat-card:hover {
  transform: translateY(-2px);
  box-shadow:
    0 2px 4px rgb(16 24 40 / 5%),
    0 10px 24px rgb(16 24 40 / 7%);
}

.dashboard-stat-card::after {
  content: "";
  position: absolute;
  top: 0;
  left: 24px;
  right: 24px;
  height: 3px;
  border-radius: 0 0 4px 4px;
  background: #5b5bd6;
}

.dashboard-stat-card span {
  margin-top: 3px;
  color: #667085;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.055em;
}

.dashboard-stat-card strong {
  margin-top: 15px;
  color: #101828;
  font-size: 40px;
  line-height: 1;
  letter-spacing: -1.2px;
}

.dashboard-stat-card small {
  margin-top: 12px;
  color: #98a2b3;
  font-size: 12px;
}


